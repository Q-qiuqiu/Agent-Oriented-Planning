# Generated benchmark data, responses, scores, caches, and local API secrets.
*.json
*.jsonl
*.sqlite
*.sqlite3
*.sqlite3*
*.db
keys/

# Python and tool caches.
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Runtime output.
*.log
*.tmp

# Current experiment datasets and generated benchmark artifacts. Keep the
# directory documentation and .gitkeep files, but do not commit local data,
# plans, expanded subtasks, timings, databases, or model responses.
yzx_test/benchmarks/**/*.json
yzx_test/benchmarks/**/*.jsonl
yzx_test/benchmarks/**/*.sqlite
yzx_test/benchmarks/**/*.sqlite3
yzx_test/benchmarks/**/*.db
yzx_test/benchmarks/legacy_old/
yzx_test/huskyqa_test/cache/
yzx_test/**/results*/

# Keep legacy experiment source code, but never its generated artifacts.
yzx_test_old/**/results*/
yzx_test_old/**/cache/
yzx_test_old/benchmarks/fastdllm_log/
